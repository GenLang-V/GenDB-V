{
 "format_version": 2,
 "dataset": {
  "tables": [
   {
    "name": "readings",
    "fields": [
     {
      "name": "value",
      "ty": "I64",
      "nullable": false
     }
    ],
    "locations": [
     "<path>"
    ],
    "format": "Parquet"
   }
  ]
 },
 "integrity_constraints": {
  "trust": "user_declared",
  "declarations": [
   {
    "table": "readings",
    "sql": "CONSTRAINT value_nonnegative CHECK (value >= 0)"
   }
  ]
 },
 "queries": [
  {
   "name": "readings-count",
   "sql": "SELECT COUNT(*) AS n FROM readings WHERE value > $1;\n",
   "limits": {
    "max_iterations": 3,
    "max_cost_usd": "unset",
    "spend_policy": "estimated_usd",
    "max_retries_per_iteration": "unset",
    "author_timeout_seconds": "unset"
   },
   "parameters": [
    {
     "index": 1,
     "name": "k",
     "type": "bigint",
     "binding": {
      "free": {}
     }
    }
   ],
   "test_bindings": [
    [
     "4"
    ]
   ]
  }
 ],
 "storage_policy": {
  "kind": "fixed_flat"
 },
 "validation": {
  "kind": "formal_proofs",
  "numeric_relative_tolerance": "0"
 },
 "hardware": {
  "threads": [
   1
  ]
 },
 "max_concurrent_queries": 1,
 "author_executable": "<path>",
