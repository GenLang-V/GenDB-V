 "queries": [
  {
   "name": "X01",
   "sql": "SELECT ow_id, ow_name, ow_rank, ow_born, ow_credit\nFROM ax_owner\nWHERE ow_id > $1 AND ow_credit >= $2 AND ow_born < $3 AND ow_name <> $4\nORDER BY ow_id;\n",
   "limits": {
    "max_iterations": 3,
    "max_cost_usd": "unset",
    "spend_policy": "estimated_usd",
    "max_retries_per_iteration": "unset",
    "author_timeout_seconds": "unset"
   },
   "parameters": [
    {
     "index": 1,
     "name": "min_id",
     "type": "bigint",
     "binding": {
      "free": {}
     }
    },
    {
     "index": 2,
     "name": "min_credit",
     "type": "numeric(15,2)",
     "binding": {
      "free": {}
     }
    },
    {
     "index": 3,
     "name": "born_before",
     "type": "date",
     "binding": {
      "free": {}
     }
    },
    {
     "index": 4,
     "name": "not_name",
     "type": "text",
     "binding": {
      "free": {}
     }
    }
   ]
  },
  {
   "name": "X02",
   "sql": "SELECT ow_id, ow_rank, ow_note\nFROM ax_owner\nWHERE (ow_rank IS NULL OR ow_rank > $1) AND ow_note IS NOT NULL\nORDER BY ow_id;\n",
   "limits": {
    "max_iterations": 3,
    "max_cost_usd": "unset",
    "spend_policy": "estimated_usd",
    "max_retries_per_iteration": "unset",
    "author_timeout_seconds": "unset"
   },
   "parameters": [
    {
     "index": 1,
     "name": "rank_above",
     "type": "integer",
     "binding": {
      "free": {}
     }
    }
   ]
  },
  {
   "name": "X03",
   "sql": "SELECT it_owner, it_line, it_qty * it_price AS amount, it_qty + it_tiny AS adjusted, it_price - $1 AS shifted\nFROM ax_item\nWHERE it_price IS NOT NULL AND it_qty > $2\nORDER BY it_owner, it_line;\n",
   "limits": {
    "max_iterations": 3,
    "max_cost_usd": "unset",
    "spend_policy": "estimated_usd",
    "max_retries_per_iteration": "unset",
    "author_timeout_seconds": "unset"
   },
   "parameters": [
    {
